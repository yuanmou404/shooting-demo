# ============================================================
# Unity 工程 Git 忽略规则（方块竞技场 Pixel Arena）
# 只上传：Assets / ProjectSettings / Packages / README / 文档
# ============================================================

# --- Unity 生成的本地缓存与产物（不需要版本控制） ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Ss]creenshots/
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*

# --- 本次跨盘迁移留下的 Library 备份（各 200~300MB），确认工程正常后可本地删除 ---
/Library_bak_*/

# --- 自动打包开关（个人本地偏好，不入库；每人自己决定开关） ---
/AutoBuild.disabled

# --- 本地工作区数据（开发笔记不对外公开） ---
/.workbuddy/

# --- Visual Studio / Rider / VS Code 生成物 ---
.vs/
.vsconfig
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userosscache
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --- 系统与编辑器临时文件 ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
